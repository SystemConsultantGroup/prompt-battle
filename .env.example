PORT=3000
ADMIN_PASSWORD=change-me

# LLM provider — set the key for ONE provider.
# Precedence: OpenAI (if OPENAI_API_KEY is set) -> Anthropic -> FakeProvider (offline).
# OpenAI keys look like sk-... / sk-proj-... ; Anthropic keys look like sk-ant-... .
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini     # Chat Completions model that accepts max_tokens (e.g. gpt-4o-mini, gpt-4o). Reasoning models (o1/o3) are not supported here.

# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8
