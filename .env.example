PORT=3000
ADMIN_PASSWORD=change-me
# Keep the SQLite file on a persistent volume in production (e.g. /data/app.sqlite).
DB_PATH=data/app.sqlite

# LLM provider — set the key for ONE provider.
# Precedence: OpenAI (if OPENAI_API_KEY is set) -> Anthropic -> FakeProvider (offline).
# OpenAI keys look like sk-... / sk-proj-... ; Anthropic keys look like sk-ant-... .
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano     # Responses API model (e.g. gpt-5-nano, gpt-4o-mini).

# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8
