PORT=3000
ADMIN_PASSWORD=change-me

# LLM provider — set the key for ONE provider.
# Precedence: OpenAI (if OPENAI_API_KEY is set) -> Anthropic -> FakeProvider (offline).
# OpenAI keys look like sk-... / sk-proj-... ; Anthropic keys look like sk-ant-... .
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8
